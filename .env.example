# Notion API Configuration
# Obtain your integration token from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_integration_token_here

# Optional: Default Notion Page or Database ID
NOTION_DEFAULT_PAGE_ID=

# Storage Mode Options:
# 1. "automatic": Prefers Google Drive for desktop when available, automatically falls back to Drive API
# 2. "gdrive_desktop": Saves directly to configured local Google Drive for desktop synchronized folder
# 3. "gdrive_api": Directly uploads to Google Drive using Drive v3 REST API with verified confirmation
# 4. "local": Local file storage only
STORAGE_MODE=automatic

# Google Drive for Desktop Synchronized Directory (e.g. G:\My Drive\YouTube-Automation)
GDRIVE_SYNC_PATH=G:\My Drive\YouTube-Automation

# Local Staging / Storage Root
LOCAL_OUTPUT_PATH=output

# Google Drive API Fallback Configuration (OAuth 2.0 Client credentials)
# Obtain from Google Cloud Console > APIs & Services > Credentials (Desktop App)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser Configuration
BROWSER_HEADLESS=false
BROWSER_SLOW_MO_MS=50
GEMINI_URL=https://gemini.google.com/app

# Automation Execution Defaults
MAX_RETRIES_PER_TASK=3
BACKOFF_BASE_SECONDS=5
BACKOFF_MAX_SECONDS=120
